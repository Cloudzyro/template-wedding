---
import Base from "../layouts/Base.astro";
import { site } from "../content/site";
---

<Base title={`Page not found | ${site.couple.first} & ${site.couple.second}`} description={site.description}>
  <main id="main" class="lost">
    <p class="eyebrow">Page not found</p>
    <h1>This path leads nowhere</h1>
    <p>The page you're looking for isn't here, but the celebration is.</p>
    <a class="button" href="/">Back to the wedding</a>
  </main>
</Base>

<style>
  .lost {
    min-height: 100vh;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
    padding: 2rem 1.25rem;
    gap: 0.5rem;
  }
  h1 {
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    margin-bottom: 0.5rem;
  }
  p {
    color: var(--ink-soft);
  }
</style>
