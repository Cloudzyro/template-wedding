---
// Soft, hand-drawn style placeholder illustrations. Swap any of them for your
// own photos: put the file in /public and use <img src="/your-photo.jpg" alt="...">.
interface Props {
  art: "arch" | "moon" | "sun" | "hills" | "flowers" | "dusk";
  alt: string;
  id: string;
}
const { art, alt, id } = Astro.props;
const g = `g-${id}`;
---

<svg viewBox="0 0 400 500" role="img" aria-label={alt} preserveAspectRatio="xMidYMid slice">
  {
    art === "arch" && (
      <>
        <defs>
          <linearGradient id={g} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#f4e6cf" />
            <stop offset="1" stop-color="#d9b892" />
          </linearGradient>
        </defs>
        <rect width="400" height="500" fill="#e9dcc6" />
        <path d="M110 470V220a90 90 0 0 1 180 0v250z" fill={`url(#${g})`} />
        <path d="M200 130v340M110 300h180" stroke="#8a6a48" stroke-width="3" opacity=".5" />
        {[0, 1, 2, 3, 4].map((i) => (
          <rect x={40 + i * 6} y={140 + i * 64} width="46" height="54" rx="3" fill={i % 2 ? "#5f7a5a" : "#b5704f"} opacity=".55" />
        ))}
        {[0, 1, 2, 3, 4].map((i) => (
          <rect x={312 - i * 4} y={150 + i * 62} width="50" height="52" rx="3" fill={i % 2 ? "#b5704f" : "#5f7a5a"} opacity=".5" />
        ))}
        <rect x="0" y="470" width="400" height="30" fill="#c9a77f" />
      </>
    )
  }
  {
    art === "moon" && (
      <>
        <defs>
          <radialGradient id={g} cx=".5" cy=".4" r=".7">
            <stop offset="0" stop-color="#dfe6d3" />
            <stop offset="1" stop-color="#a9b89a" />
          </radialGradient>
        </defs>
        <rect width="400" height="500" fill={`url(#${g})`} />
        <ellipse cx="200" cy="320" rx="130" ry="82" fill="#5f7a5a" opacity=".85" />
        <circle cx="300" cy="270" r="48" fill="#5f7a5a" opacity=".85" />
        <path d="M282 232l8-30 18 22zM318 232l12-26 8 30z" fill="#5f7a5a" opacity=".85" />
        <path d="M90 340c-30 10-40 60 10 70" stroke="#5f7a5a" stroke-width="22" fill="none" stroke-linecap="round" opacity=".85" />
        <path d="M285 272q8 6 16 0M310 272q8 6 16 0" stroke="#e9e3d2" stroke-width="3" fill="none" stroke-linecap="round" />
        <circle cx="90" cy="110" r="34" fill="#f7f1e3" opacity=".8" />
      </>
    )
  }
  {
    art === "sun" && (
      <>
        <defs>
          <linearGradient id={g} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#f8efd9" />
            <stop offset="1" stop-color="#ead6a6" />
          </linearGradient>
        </defs>
        <rect width="400" height="500" fill={`url(#${g})`} />
        {[
          [110, 160, 300],
          [220, 110, 420],
          [310, 200, 260],
        ].map(([x, y, h]) => (
          <g>
            <path d={`M${x} ${y + 30}V500`} stroke="#5f7a5a" stroke-width="6" />
            <path d={`M${x} ${y + 140}c-30-10-44 10-50 24 22 6 40 0 50-24z`} fill="#6f8b66" />
            {Array.from({ length: 12 }, (_, i) => (
              <ellipse cx={x} cy={y - 26} rx="9" ry="24" fill="#e0a83a" transform={`rotate(${i * 30} ${x} ${y})`} />
            ))}
            <circle cx={x} cy={y} r="20" fill="#7a4b2a" />
          </g>
        ))}
      </>
    )
  }
  {
    art === "hills" && (
      <>
        <defs>
          <linearGradient id={g} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#f3d9b8" />
            <stop offset=".6" stop-color="#f6e9d4" />
          </linearGradient>
        </defs>
        <rect width="400" height="500" fill={`url(#${g})`} />
        <circle cx="270" cy="200" r="46" fill="#f2b880" opacity=".9" />
        <path d="M0 270q120-80 220-20t180-10v260H0z" fill="#a9b89a" />
        <path d="M0 330q90-60 200-10t200 0v180H0z" fill="#7f9874" />
        <path d="M0 400q140-50 260 0t140 0v100H0z" fill="#5f7a5a" />
        <path d="M60 470l20-56 20 56M300 460l16-44 16 44" fill="#3f5a3d" />
      </>
    )
  }
  {
    art === "flowers" && (
      <>
        <rect width="400" height="500" fill="#f5eee1" />
        <rect x="40" y="40" width="320" height="420" fill="none" stroke="#d6c3a5" stroke-width="2" />
        {[
          [130, 170, "#c47e62"],
          [250, 140, "#d8a5a0"],
          [200, 270, "#b5704f"],
          [120, 340, "#d8a5a0"],
          [280, 320, "#c47e62"],
        ].map(([x, y, c]) => (
          <g>
            <path d={`M${x} ${Number(y) + 20}q-10 60 ${x > 200 ? 20 : -20} 110`} stroke="#6f8b66" stroke-width="3" fill="none" />
            {Array.from({ length: 5 }, (_, i) => (
              <ellipse cx={x} cy={Number(y) - 14} rx="10" ry="16" fill={String(c)} opacity=".85" transform={`rotate(${i * 72} ${x} ${y})`} />
            ))}
            <circle cx={x} cy={y} r="6" fill="#e0a83a" />
          </g>
        ))}
      </>
    )
  }
  {
    art === "dusk" && (
      <>
        <defs>
          <linearGradient id={g} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#3b4a5e" />
            <stop offset=".55" stop-color="#b98a8a" />
            <stop offset="1" stop-color="#f0c9a8" />
          </linearGradient>
        </defs>
        <rect width="400" height="500" fill={`url(#${g})`} />
        {[
          [60, 60],
          [140, 90],
          [320, 50],
          [250, 120],
          [360, 140],
        ].map(([x, y]) => (
          <circle cx={x} cy={y} r="2.5" fill="#fbf3e4" />
        ))}
        <path d="M30 500V330h180v170" fill="#2f3b30" />
        <path d="M10 340l110-70 110 70z" fill="#26302a" />
        <rect x="70" y="370" width="40" height="50" fill="#f3c97a" opacity=".9" />
        <rect x="140" y="370" width="40" height="50" fill="#f3c97a" opacity=".6" />
        <path d="M30 440h180" stroke="#26302a" stroke-width="8" />
      </>
    )
  }
</svg>

<style>
  svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
